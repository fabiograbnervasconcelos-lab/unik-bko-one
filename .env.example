# bko = painel CRM × GED | whatsapp-crm = robô vendedores (UI e scheduler distintos)
APP_MODE=bko
# No painel BKO: desliga só o bot de vendedores (mantém WhatsApp dos grupos)
DISABLE_VENDOR_BOT=
# Desliga o WhatsApp inteiro (não use no BKO se quiser alertas GED)
DISABLE_WHATSAPP=
CRM_USER=
CRM_PASS=
GED_USER=
GED_PASS=
GED_DOMAIN=1
WHATSAPP_GROUP_BKO=bko one urgente
WHATSAPP_GROUP_GERENTES=gerentes one
OWNER_WHATSAPP=4891940908
CHROME_PATH=
FATURA_ROBO_URL=https://robo-one-telecom-production.up.railway.app
